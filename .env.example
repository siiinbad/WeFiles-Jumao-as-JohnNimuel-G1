# Copy to .env locally. Never commit credentials.
SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Supabase Connect > Session pooler; URL-encode special password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Local PostgreSQL is also supported; there is no SQLite fallback.
# DATABASE_URL=postgresql://wefiles:PASSWORD@127.0.0.1:5432/wefiles
TRUST_PROXY=False
PRIVATE_STORAGE_BACKEND=local
PRIVATE_MEDIA_ROOT=media
# On Render use PRIVATE_STORAGE_BACKEND=supabase and fill all five values.
# Use a PRIVATE bucket. These S3 credentials stay on the Django server.
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=wefiles-private
# Optional separate, disposable database. Never reuse production.
TEST_DATABASE_URL=
# Required only for tests that flush a disposable Supabase project:
ALLOW_DISPOSABLE_SUPABASE_TESTS=no
