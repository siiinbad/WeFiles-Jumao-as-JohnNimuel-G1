# Generate a new random key locally. Never commit your real .env.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Supabase Connect > Session pooler. URL-encode the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional, DESTRUCTIVE integration tests: use a separate disposable project.
TEST_DATABASE_URL=
TRUST_PROXY=False
